---
# ADR-0321 Decision 5: a Lake's engine reads its bound Secret only from its environment, so on every pass the Lake
# reconciler asks secret::read as the Lake before it starts the engine. A denial holds the Lake and stops a running
# engine; a held Lake's pass runs again after controller.referentPollInterval, as after a missing Secret, since no
# Policy change queues a Lake. A Ready Lake's pass runs again each runtime.supervisionPeriod (ADR-0142), which is how a
# forbid reaches a running engine. Environment: the operator applies and deletes the forbid, and the controller runs a
# queued pass, one at a time. Left to tests: the pass's order inside funcd (the resolve, then Converge or the hold's
# Teardown) and the engine's real stop, which ADR-0321's lake-secret-forbid scenarios hold.
deadlock_detection: false
options:
  # The operator and the reconciler; every action is atomic, so two concurrent actions cover every interleaving.
  max_concurrent_actions: 2
  # A forbid, its delete and the pass that follows: the smallest bound at which every mutant fails (3 cuts the run
  # before the engine starts again); 10 passes too.
  max_actions: 4
  crash_on_yield: false
---
# diagram: phase
# mutant requeue-on-notfound-only: liveness
# mutant no-check-at-start: NoEngineStartsWhileForbidden
# mutant no-ready-repass: liveness

# requeue-on-notfound-only: the rule before ADR-0321, where only a missing Secret asks again. no-check-at-start: the
# pass starts the engine without asking. no-ready-repass: a Ready Lake is not passed again.
MUTANT = ""

action Init:
    forbidden = False
    phase = "new"
    engine = "stopped"
    queued = True
    toggles = 0
    started_forbidden = False

# The operator applies the forbid, then may delete it; neither queues the Lake.
atomic action Toggle:
    require toggles < 2
    forbidden = not forbidden
    toggles = toggles + 1

# One pass: secret::read as the Lake, then start the engine, or hold the Lake and stop its engine.
atomic fair action Pass:
    require queued
    queued = False
    denied = forbidden
    if MUTANT == "no-check-at-start":
        denied = False
    if denied:
        phase = "held"
        engine = "stopped"
        if MUTANT != "requeue-on-notfound-only":
            queued = True
    else:
        if engine == "stopped" and forbidden:
            started_forbidden = True
        engine = "running"
        phase = "ready"
        if MUTANT != "no-ready-repass":
            queued = True

always assertion NoEngineStartsWhileForbidden:
    return not started_forbidden

# Once the forbid is deleted, the engine runs again with no other change.
always eventually assertion AHeldLakeComesBack:
    return forbidden or engine == "running"

# A forbid applied while the engine runs stops it.
always eventually assertion AForbidReachesARunningEngine:
    return not forbidden or engine == "stopped"
