---
# An add-on object's in-place Restore (ADR-0333 Decisions 3 and 4). The Restore holds the namespace, puts the copy in
# restore.path and marks the object Loading. The reconciler starts each engine from the object's spec, with
# restore.env while the object is Loading, and replaces a running engine whose start env differs from that. An engine
# started with restore.env loads the copy at its start, and fails to start when the copy is gone or hiqlite's crash
# marker stands. Once that engine runs, the reconciler removes the copy; once the copy is gone, it sets Loaded. The
# Restore lifts the hold once an engine runs without restore.env. It can end first, keeping the hold: funcd crashes
# (the next start ends it Interrupted) or the wait passes restore.timeout (RestoreTimedOut); then the copy and the
# mark are cleared. An engine may crash at any time; the reconciler starts the next one from the spec. A write
# reaches the engine through the edge only while it runs and the namespace is not held (ADR-0290).
# Environment: the runtime replaces an engine with SIGTERM and its grace (ADR-0277), so hiqlite removes its crash
# marker first, as at funcd's own stop; after funcd's crash, the next start's boot sweep kills the engine with no
# grace, so the marker stands. An engine starts from the current spec, never with an old container's env. An engine's
# own crash leaves no marker here: an engine that restores after a crash is the one that could roll a write back.
# funcd's own calls at the engine's address (ADR-0335's discovery, tokens and keys) are not held, and ADR-0336's
# registrar does nothing while the namespace is held: a write such a call makes during the hold can be rolled back by
# a crash before the copy's removal. Left out: the copy's transfer, which the backup service checks.
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 13
  crash_on_yield: false
---
# diagram: phase
# mutant lift-early: NoAckedWriteRolledBack
# mutant clear-first: TheCopyIsLoaded
# mutant loaded-first: TheCopyIsLoaded
# mutant never-clear: liveness
# mutant keep-mark: liveness
# mutant skip-hold: NoAckedWriteRolledBack

# lift-early: the Restore lifts the hold once an engine loaded the copy, while that engine still runs with restore.env.
# clear-first: the reconciler removes the copy before the engine that loads it started, so the Restore lifts the hold
#   over an engine that never loaded it.
# loaded-first: the reconciler sets Loaded before it removed the copy, so the Restore lifts the hold over the engine
#   that ran before the Restore, which never loaded the copy.
# never-clear: the mark outlives the load, so the hold never lifts.
# keep-mark: the mark outlives its ended Restore, so each start runs with restore.env over hiqlite's crash marker.
# skip-hold: a writer reaches the engine while the namespace is held, as a path that skipped ADR-0290's check would.
MUTANT = ""

action Init:
    phase = "running"
    held = False
    copy = False
    pending = False
    engine = "up"
    env = False
    loaded = False
    marker = False
    data = "old"
    acked = False
    crashes = 0

atomic fair action Hold:
    require phase == "running"
    held = True
    phase = "held"

atomic fair action Place:
    require phase == "held"
    copy = True
    phase = "placed"

atomic fair action Mark:
    require phase == "placed"
    pending = True
    phase = "marked"

# SIGTERM to an engine whose start env is not the spec's.
atomic fair action Replace:
    require engine == "up"
    require env != pending
    engine = "down"

# A start without restore.env recovers from hiqlite's crash marker.
atomic fair action Start:
    require engine == "down"
    env = pending
    if not env:
        marker = False
        engine = "up"
    elif copy and not marker:
        data = "copy"
        loaded = True
        engine = "up"

atomic fair action Remove:
    require pending
    require copy
    if MUTANT != "clear-first":
        require engine == "up" and env
    copy = False

# Loaded: the next engine starts without restore.env.
atomic fair action Clear:
    require pending
    if MUTANT != "loaded-first":
        require not copy
    if MUTANT != "never-clear":
        pending = False

atomic fair action Lift:
    require phase == "marked"
    if MUTANT == "lift-early":
        require loaded
    else:
        require not pending and engine == "up" and not env
    held = False
    phase = "done"

# funcd crashes: the next start ends the Restore Interrupted, and its boot sweep kills the engine.
atomic action Interrupt:
    require phase == "marked"
    phase = "ended"
    if engine == "up":
        marker = True
        engine = "down"

# The wait passes restore.timeout: the Restore fails RestoreTimedOut.
atomic action TimeOut:
    require phase == "marked"
    phase = "ended"

# An ended Restore's clear: the copy, then the mark. The hold stays.
atomic fair action ClearEnded:
    require phase == "ended"
    require copy or pending
    if MUTANT != "keep-mark":
        copy = False
        pending = False

atomic action Crash:
    require engine == "up"
    require crashes < 1
    engine = "down"
    crashes += 1

atomic action Write:
    require engine == "up"
    if MUTANT != "skip-hold":
        require not held
    require data != "old"
    data = "copy+"
    acked = True

always assertion NoAckedWriteRolledBack:
    return not acked or data == "copy+"

always assertion TheCopyIsLoaded:
    return phase != "done" or loaded

always eventually assertion TheRestoreEnds:
    return phase == "done" or phase == "ended"

always eventually assertion TheEngineRunsWithoutRestoreEnv:
    return engine == "up" and not env and not pending
