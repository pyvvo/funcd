---
# An Addon's revisions and the objects that pin them (ADR-0339 Decisions 1 to 5). An admin updates the Addon; the
# Addon's pass stamps a revision for its latest generation and makes it current. A standalone object pins the current
# revision at its first pass and at each new generation. An App's revision records the current revision, or, when its
# spec is that of a kept revision that was current once (a rollback), that revision's record; its hook input's `from`
# is what the part runs at the stamp. The revision is Applied once its pre-hooks are done and its parts are written,
# and a later pass that stops turns that False again. A part moves only to the record of the App's latest revision,
# once it is Applied and above the one the part follows, and never goes back. The App switches to a revision once it
# is Applied and its part pins its record, and then its post-hooks run. The App
# keeps its current revision and its newest two. The Addon's pass, which requeues itself while a revision is not
# current, removes a revision that is not current, that no object pins and that no kept App revision records.
# Environment: every pass is one step of the controller's one worker (pkg/funcd/funcd.go:767); the writes of the admin
# and the users come through the API between passes. Left out: several Addons, objects, kinds and parts, the engines
# the pins start, and the hooks' calls.
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 28
  crash_on_yield: false
---
# diagram: current
# mutant split-pass: PinsExist
# mutant ignore-records: RecordsExist
# mutant retire-current: PinsExist
# mutant never-retire: liveness
# mutant follow-current: NoMoveByItself
# mutant newest-applied: MovesOnlyToTheLatestApplied
# mutant switch-early: PostHooksSeeTheNewEngine
# mutant follow-superseded: MovesOnlyToTheLatestApplied
# mutant move-early: MovesOnlyToTheLatestApplied
# mutant from-current: HooksSeeTheMove
# mutant retire-pinned: PinsExist

# split-pass: an object's pass reads the current revision in one step and pins it in another, as two workers would.
# ignore-records: the Addon's pass removes a revision that a kept App revision records.
# retire-current: the Addon's pass removes the current revision too.
# never-retire: the Addon's pass removes nothing.
# follow-current: a standalone object follows the Addon's current revision with no new generation.
# newest-applied: a part follows the newest Applied App revision, even one below the one it follows.
# switch-early: the App switches before its part pins the revision's record.
# follow-superseded: a part moves to any newer Applied revision, a superseded one too, while the latest's pre-hooks run.
# move-early: a part moves to the latest revision before it is Applied, while its pre-hooks run.
# from-current: the hook input's from is the App's current revision's record, not what the part runs.
# retire-pinned: the Addon's pass removes a revision an object pins.
MUTANT = ""

action Init:
    generation = 1
    current = 1
    revs = set([1])
    updates = 0
    s_gen = 1
    s_seen = 0
    s_pin = 0
    s_next = 0
    edits = 0
    apps = [{"n": 1, "record": 1, "from": 0, "applied": True, "once": True}]
    app_current = 1
    stamps = 0
    rollbacks = 0
    stops = 0
    p_app = 0
    p_pin = 0

atomic action Update:
    require updates < 1
    updates += 1
    generation += 1

atomic fair action Stamp:
    require current != generation
    revs.add(generation)
    current = generation

atomic action Edit:
    require edits < 1
    edits += 1
    s_gen += 1

atomic fair action ObjectPass:
    require MUTANT != "split-pass"
    if MUTANT == "follow-current":
        require s_seen != s_gen or s_pin != current
    else:
        require s_seen != s_gen
    s_pin = current
    s_seen = s_gen

atomic fair action ObjectRead:
    require MUTANT == "split-pass"
    require s_seen != s_gen
    require s_next == 0
    s_next = current

atomic fair action ObjectPin:
    require MUTANT == "split-pass"
    require s_next != 0
    s_pin = s_next
    s_seen = s_gen
    s_next = 0

# What the part runs at a stamp, the hook input's from; the round-2 text's current revision's record for the mutant.
func hook_from():
    if MUTANT == "from-current":
        for a in apps:
            if a["n"] == app_current:
                return a["record"]
    return p_pin

# A new App revision: a changed spec records the current revision.
atomic action AppStamp:
    require stamps < 2
    stamps += 1
    f = hook_from()
    apps.append({"n": apps[-1]["n"] + 1, "record": current, "from": f, "applied": False, "once": False})

# A rollback: the spec of a kept revision that was current once, the current one included, and its record.
atomic action AppRollback:
    require rollbacks < 1
    i = oneof range(len(apps))
    require apps[i]["once"]
    rollbacks += 1
    f = hook_from()
    apps.append({"n": apps[-1]["n"] + 1, "record": apps[i]["record"], "from": f, "applied": False, "once": False})

# The latest revision's pre-hooks are done and its parts written.
atomic fair action AppApply:
    require not apps[-1]["applied"]
    require stops < 1 or apps[-1]["n"] > app_current
    apps[-1]["applied"] = True

# A later pass of the latest revision stops, as ADR-0200 Decision 5 records.
atomic action AppPassStops:
    require stops < 1
    require apps[-1]["applied"] and apps[-1]["n"] != app_current
    stops += 1
    apps[-1]["applied"] = False

# The App switches to its latest revision once it is Applied and its part is Ready for it.
atomic fair action AppSwitch:
    require apps[-1]["applied"] and apps[-1]["n"] != app_current
    if MUTANT != "switch-early":
        require p_app == apps[-1]["n"]
    app_current = apps[-1]["n"]
    apps[-1]["once"] = True

# ADR-0200 Decision 8: keep the current revision and the newest two.
atomic fair action AppPrune:
    require len(apps) > 2
    require apps[0]["n"] != app_current
    apps.pop(0)

# The part's pass: it moves to the latest revision once that is Applied (the mutants pick another).
atomic fair action PartPass:
    best = apps[-1]["n"]
    record = apps[-1]["record"]
    if MUTANT == "newest-applied" or MUTANT == "follow-superseded":
        best = 0
        for a in apps:
            if a["applied"] and a["n"] > best:
                best = a["n"]
                record = a["record"]
        require best != 0
    elif MUTANT != "move-early":
        require apps[-1]["applied"]
    if MUTANT == "newest-applied":
        require best != p_app
    else:
        require best > p_app
    p_app = best
    p_pin = record

atomic fair action Retire:
    require MUTANT != "never-retire"
    r = oneof revs
    if MUTANT != "retire-current":
        require r != current
    if MUTANT != "retire-pinned":
        require r != s_pin and r != p_pin
    if MUTANT != "ignore-records":
        for a in apps:
            require r != a["record"]
    revs.remove(r)

always assertion PinsExist:
    return (s_pin == 0 or s_pin in revs) and (p_pin == 0 or p_pin in revs)

always assertion RecordsExist:
    for a in apps:
        if a["record"] not in revs:
            return False
    return True

transition assertion NoMoveByItself(before, after):
    if after.s_pin != before.s_pin and before.s_pin != 0 and after.s_seen == before.s_seen:
        return False
    if after.p_pin != before.p_pin and after.p_app <= before.p_app:
        return False
    return True

transition assertion PostHooksSeeTheNewEngine(before, after):
    if after.app_current == before.app_current:
        return True
    for a in after.apps:
        if a["n"] == after.app_current and after.p_pin != a["record"]:
            return False
    return True

transition assertion MovesOnlyToTheLatestApplied(before, after):
    if after.p_app == before.p_app:
        return True
    return after.p_app == after.apps[-1]["n"] and after.apps[-1]["applied"]

transition assertion HooksSeeTheMove(before, after):
    if after.p_app == before.p_app or before.p_app == 0:
        return True
    for a in after.apps:
        if a["n"] == after.p_app:
            return a["from"] == before.p_pin and a["record"] == after.p_pin
    return True

always eventually assertion UnusedAreRemoved:
    for r in revs:
        if r == current or r == s_pin or r == p_pin:
            continue
        used = False
        for a in apps:
            if a["record"] == r:
                used = True
        if not used:
            return False
    return True
