---
# A workload's write of one key of a Secret (ADR-0327). A write reads the stored Secret and its resourceVersion, asks
# Cedar secret::write as its caller, sets or removes its one key, and updates with the read's resourceVersion as the
# precondition; a Conflict starts over from the read, at most ATTEMPTS times, then answers 409. Writer 0 is the
# Secret's owner and puts key a; writer 1 holds a writer-role grant and deletes key b. A person's apply replaces the
# data whole and names no owner, as the API's apply of a manifest with other data and no owner does.
# Environment: the store's Update is atomic and compares the resourceVersion inside its transaction (internal/store);
# the decision reads the stored owner after the write's read; no grant changes during the run.
# Left out: the decision's entities and the roles (TestScenarioSecretWriterRole), the value checks and a missing
# Secret (TestScenarioSecretWriteChecksTheValue), the pool key (TestScenarioSecretOwnerSplitsThePool), and the routes
# and shims (the e2e scenarios).
deadlock_detection: false
options:
  max_concurrent_actions: 3
  max_actions: 16
  crash_on_yield: false
---
# diagram: Writer.phase
# mutant blind-update: OnlyWritersWrite
# mutant stale-retry: AckedWritesStay
# mutant decide-first: OnlyWritersWrite
# mutant no-bound: AttemptsAreBounded
# mutant no-reread: liveness

ATTEMPTS = 2
# blind-update: the update carries no resourceVersion, so it lands on whatever the store holds.
# stale-retry: a retry keeps the data it first read and takes only the new resourceVersion.
# decide-first: the write asks Cedar before it reads the Secret, so it can land at a version the decision never saw.
# no-bound: a Conflict always starts over.
# no-reread: a Conflict leaves the write waiting for a read that never comes.
MUTANT = ""

role Writer:
    action Init:
        self.phase = "idle"
        self.attempts = 0
        self.seen_rv = -1
        self.seen = {}
        self.epoch = -1

    # The read of the stored Secret and its resourceVersion; with decide-first it follows the decision.
    atomic fair action Read:
        if MUTANT == "decide-first":
            require self.phase == "early"
        elif MUTANT == "no-reread":
            require self.phase == "idle"
        else:
            require self.phase in ["idle", "retry"]
        self.seen_rv = rv
        if not (MUTANT == "stale-retry" and self.attempts > 0):
            self.seen = dict(data)
        if MUTANT == "decide-first":
            self.phase = "decided"
        else:
            self.phase = "read"

    # Cedar's secret::write: the owner, or writer 1's grant, which no apply removes.
    atomic fair action Decide:
        if MUTANT == "decide-first":
            require self.phase in ["idle", "retry"]
        else:
            require self.phase == "read"
        if owner != self.id and self.id != 1:
            self.phase = "denied"
            return
        if MUTANT == "decide-first":
            self.phase = "early"
        else:
            self.phase = "decided"

    # The update with the read's resourceVersion as its precondition.
    atomic fair action Update:
        require self.phase == "decided"
        if MUTANT == "blind-update" or rv == self.seen_rv:
            new = dict(self.seen)
            if self.id == 0:
                new["a"] = "w"
            elif "b" in new:
                new.pop("b")
            if self.id == 0 and owner != 0:
                stolen = True
            data = new
            rv = rv + 1
            self.epoch = applies
            self.phase = "acked"
            return
        self.attempts = self.attempts + 1
        if MUTANT != "no-bound" and self.attempts >= ATTEMPTS:
            self.phase = "conflict"
        else:
            self.phase = "retry"

action Init:
    rv = 0
    data = {"a": "0", "b": "0"}
    owner = 0
    applies = 0
    stolen = False
    writers = []
    for i in range(2):
        writers.append(Writer(id=i))

# A person's apply: other data, and no owner.
atomic action Apply:
    require applies < 2
    applies = applies + 1
    data = {"a": "p", "b": "p"}
    owner = -1
    rv = rv + 1

# An acknowledged write stays until a person's apply replaces the data: a write of another key never drops it.
always assertion AckedWritesStay:
    for w in writers:
        if w.phase == "acked" and w.epoch == applies:
            if w.id == 0 and data.get("a") != "w":
                return False
            if w.id == 1 and "b" in data:
                return False
    return True

# A write lands only while its writer may write: an owner the apply removed writes nothing after it.
always assertion OnlyWritersWrite:
    return not stolen

# A write gives up after ATTEMPTS conflicts in a row.
always assertion AttemptsAreBounded:
    for w in writers:
        if w.attempts > ATTEMPTS:
            return False
    return True

# Every write ends: acknowledged, refused, or 409 after its conflicts.
always eventually assertion WritesEnd:
    for w in writers:
        if w.phase not in ["acked", "denied", "conflict"]:
            return False
    return True
