---
# The edge's sign-in client against its rotation and a provider that purges it (ADR-0336). A registrar pass that
# finds the rotation not yet observed updates the client (RFC 7592 PUT): the provider issues a new secret and refuses
# the old one at once. The pass writes the answer into the client Secret, then records the rotation as observed. A
# pass that finds the stored client gone (purged, or never stored) registers a new one and writes it. The registrar
# may crash between any two steps of a pass; the next pass starts over from the stored state. A sign-in reads the
# Secret, exchanges its code with what it read, and when the provider refuses the client, reads the Secret once more
# and exchanges again. Environment: the provider answers each call; a Secret write is atomic; a pass runs again after
# a crash (the supervision period). Left out: the callbacks' update, which is the same PUT.
deadlock_detection: false
options:
  max_concurrent_actions: 2
  max_actions: 14
  crash_on_yield: false
---
# diagram: reg
# mutant observe-first: liveness
# mutant no-reread: NoSignInFailsWithTheCurrentClientStored

# observe-first: the pass records the rotation as observed before it writes the new secret, so a crash between them
#   leaves the refused secret stored for good.
# no-reread: a refused exchange retries with the secret the sign-in first read.
MUTANT = ""

action Init:
    client = 1
    secret = 1
    sc = 1
    ss = 1
    rotate = 1
    observed = 0
    reg = "idle"
    ac = 0
    asec = 0
    nextc = 2
    nexts = 2
    faults = 0
    sin = "idle"
    rc = 0
    rs = 0
    bad = False

atomic fair action Put:
    require reg == "idle"
    require sc == client and observed < rotate
    secret = nexts
    nexts += 1
    ac = client
    asec = secret
    if MUTANT == "observe-first":
        reg = "observe"
    else:
        reg = "store"

atomic fair action Register:
    require reg == "idle"
    require sc != client
    client = nextc
    nextc += 1
    secret = nexts
    nexts += 1
    ac = client
    asec = secret
    reg = "store"

atomic fair action Store:
    require reg == "store"
    sc = ac
    ss = asec
    if MUTANT == "observe-first" or observed == rotate:
        reg = "idle"
    else:
        reg = "observe"

atomic fair action Observe:
    require reg == "observe"
    observed = rotate
    if MUTANT == "observe-first":
        reg = "store"
    else:
        reg = "idle"

atomic action RegistrarCrash:
    require reg != "idle"
    require faults < 1
    reg = "idle"
    faults += 1

atomic action Purge:
    require faults < 1
    require client != 0
    client = 0
    faults += 1

atomic action SignInReads:
    require sin == "idle"
    rc = sc
    rs = ss
    sin = "read"

atomic action SignInExchanges:
    require sin == "read"
    if rc == client and rs == secret:
        sin = "done"
    else:
        sin = "refused"

atomic action SignInRetries:
    require sin == "refused"
    if MUTANT != "no-reread":
        rc = sc
        rs = ss
    if rc == client and rs == secret:
        sin = "done"
    else:
        bad = sc == client and ss == secret
        sin = "failed"

always assertion NoSignInFailsWithTheCurrentClientStored:
    return not bad

always eventually assertion TheSecretConverges:
    return reg == "idle" and sc == client and ss == secret and observed == rotate
