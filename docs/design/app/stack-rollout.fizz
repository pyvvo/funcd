---
# An App's rollout with a stack (ADR-0357 Decisions 1 to 5). The App's latest revision holds an engineless part, the
# stack, whose change waits for a person's approval; a part that reads the stack's outputs from the Secret the stack's
# Job owns; an older part that the revision drops; and, in one of the two Apps explored, a post-hook. A pass writes the
# reader once the outputs exist, switches the revision while no part is Pending, fails it at the deadline while one is,
# then, in a later pass, starts the post-hook and prunes while no part is Lagging. A person may approve the stack's run,
# which applies the change and writes the outputs. Environment: the controller runs one pass of an App at a time, so a
# pass is one step; the Secret's watch requeues the App after the outputs are written, so a pass follows (fair); the
# clock is Tick, bounded by the deadline. Left out: the parts funcd runs, judged by ADR-0199 as before; tests hold them.
deadlock_detection: false
options:
  max_concurrent_actions: 1
  max_actions: 6
  crash_on_yield: false
---
# diagram: revision, reader
# mutant stack-pending: NoFailWhileAStackWaits
# mutant reader-pending: NoFailWhileAStackWaits
# mutant reader-early: ReaderWaitsForOutputs
# mutant hook-early: PostHookAfterStacks
# mutant prune-early: OldPartServesUntilReplaced
# mutant no-reader-write: liveness

# stack-pending: a stack whose change is not applied counts as Pending, as before this ADR.
# reader-pending: a part that waits for the outputs counts as Pending.
# reader-early: a pass writes the reader before the outputs exist.
# hook-early: a pass starts the post-hook while a part is Lagging.
# prune-early: a pass prunes while a part is Lagging.
# no-reader-write: a pass never writes a part that waited for the outputs.
MUTANT = ""

DEADLINE = 2

action Init:
    h = oneof [True, False]
    has_hook = h
    revision = "deploying"
    approved = False
    applied = False
    reader = "absent"
    old = "serving"
    hook = "due"
    clock = 0

# A person approves the stack's run; nothing makes them.
atomic action Approve:
    require not approved
    approved = True

# The approved run applies the change, and the runtime writes the outputs into the Job's Secret.
atomic fair action Apply:
    require approved and not applied
    applied = True

# One pass of the App reconciler.
atomic fair action Pass:
    was_current = revision == "current"
    if (applied or MUTANT == "reader-early") and MUTANT != "no-reader-write":
        reader = "written"
    stack_pending = MUTANT == "stack-pending" and not applied
    reader_pending = MUTANT == "reader-pending" and reader != "written"
    lagging = not applied or reader != "written"
    if revision == "deploying":
        if not stack_pending and not reader_pending:
            revision = "current"
        elif clock >= DEADLINE:
            revision = "failed"
    if was_current and has_hook and (not lagging or MUTANT == "hook-early"):
        hook = "done"
    if was_current and (not has_hook or hook == "done") and (not lagging or MUTANT == "prune-early"):
        old = "pruned"

# Time passes while the revision deploys, up to its deadline.
atomic fair action Tick:
    require revision == "deploying" and clock < DEADLINE
    clock += 1

always assertion NoFailWhileAStackWaits:
    return revision != "failed"

always assertion ReaderWaitsForOutputs:
    return reader != "written" or applied

always assertion PostHookAfterStacks:
    return hook != "done" or (applied and reader == "written")

always assertion OldPartServesUntilReplaced:
    return old == "serving" or reader == "written"

eventually always assertion Switches:
    return revision == "current"

eventually always assertion ConvergesOnceApproved:
    return not approved or (reader == "written" and old == "pruned" and (not has_hook or hook == "done"))
