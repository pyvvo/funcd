# Build artifacts and installed deps for the s3-roundtrip example — regenerated by `just lima-example-s3`
# (npm install → @aws-sdk/client-s3; esbuild → roundtrip.mjs). The .mjs bundles the AWS SDK (~1.4 MB),
# so it is a build output, not a tracked source artifact (unlike log-burst's tiny dependency-free bundle).
.npm-cache/
node_modules/
package-lock.json
roundtrip.mjs
