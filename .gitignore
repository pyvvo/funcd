result
coverage.out

# Editor cruft
*.swp
*.swo
*~
.vscode/

# local build/tool cache (lima deps, etc.)
.cache/

# tool run logs (e.g. Venom writes venom.log + rotated venom.N.log in CWD — e2e/ spike)
*.log

# Badger DB scratch — a stray local data dir if funcd/tests run with a repo-relative data dir
# (metastore at <dataDir>/store, KV service at <dataDir>/kv — ADR-0065/0066)
/store/
/kv/
cmd/**/store/
cmd/**/kv/

# build.sh output (ADR-0026)
/dist/
/server
/funcdctl
/funcd-bench

__pycache__
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Python kv-counter example build outputs (regenerate with `uv run --group build python build.py`)
/examples/python/kv-counter/counter.py
/examples/python/kv-counter/counter.schema.json

# Python log-burst example build outputs (ADR-0090 contract — `uv run --group build python build.py`)
/examples/python/log-burst/handler.py
/examples/python/log-burst/handler.schema.json

# JS contract-schema build outputs (ADR-0090 `--schema` docs; the .mjs are handled per-example)
/examples/js/log-burst/burst.schema.json
/examples/js/s3-roundtrip/roundtrip.schema.json

# Function dependency-bundle build output (ADR-0089 deployment package: handler + vendored native
# deps) — a `bundle/` dir in ANY example/subproject; never commit the (often ~100MB) vendored closure
bundle/

# generated by `just lima-report` (the Lima bench harness output)
docs/reports/lima-footprint-report.*
