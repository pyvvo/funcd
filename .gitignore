# no trailing slash: also ignores a `node_modules` symlink
node_modules
/bin/
/funcd
/specgen
*.test
.DS_Store
.direnv/
result
coverage.out

# Editor cruft
*.swp
*.swo
*~
.vscode/

# local build/tool cache (lima deps, etc.)
.cache/

# tool run logs (e.g. Venom writes venom.log + rotated venom.N.log in CWD — e2e/ spike)
*.log

# Badger DB scratch — a stray local data dir if funcd/tests run with a repo-relative data dir
# (metastore at <dataDir>/store, KV service at <dataDir>/kv — ADR-0065/0066)
/store/
/kv/
cmd/**/store/
cmd/**/kv/

# build.sh output (ADR-0026)
/dist/
/server
/funcdctl
/funcd-bench

# compiled bench harnesses — build outputs of their own module, never committed (regenerate with `go build`)
/bench/expr-engine/expr-engine

__pycache__
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# writable copies of the pinned language-repo examples (ADR-0141: scripts/example-copy.sh, lane `copy: true`)
.modcopy/

# a local go.work overriding the language-module pins for cross-repo work (ADR-0141) — never committed
go.work
go.work.sum

# Function dependency-bundle build output (ADR-0089 deployment package: handler + vendored native
# deps) — a `bundle/` dir in ANY example/subproject; never commit the (often ~100MB) vendored closure
bundle/

# generated by `just lima-report` (the Lima bench harness output)
docs/reports/lima-footprint-report.*

raw_data/
data/
.dvc/tmp/

# nektos/act local build artifacts (the funcdctl-*.zip from the local build workflow)
.act-artifacts/

# funcdctl dev writes this transient contract into the tree (cleaned on exit; ignore crash leftovers)
.funcd-contract.json

# funcdctl dev --persist state dir (durable Badger metastore/kv + fileblob under per-service subdirs,
# ADR-0125 Decision 7) — a `.funcd-dev/` dir in ANY manifest/working dir; never committed
.funcd-dev/

# S3-gateway node master secret — generated at runtime by LoadOrCreateMaster (ADR-0085), never committed
**/s3gateway/master.key
