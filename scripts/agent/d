#!/usr/bin/env bash
# d — run a command in the pinned dev-shell environment without re-evaluating the flake.
#
#   scripts/agent/d go test ./internal/function/
#
# `nix develop -c <cmd>` costs ~2 s per call; this sources a cached `nix print-dev-env` (~0.02 s), regenerated
# whenever flake.nix or flake.lock change. Same toolchain, same Go env. Meant for agents and scripts that run
# many short commands; interactive work can keep using `nix develop`.
set -euo pipefail
root=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
key=$(cat "$root/flake.nix" "$root/flake.lock" | shasum | cut -c1-16)
env_file="$root/.cache/devshell-env-$key.sh"
# A call nested in another (gate.sh under `d timeout`) keeps the environment it inherits (#853). It trusts that
# environment: a process in between that resets PATH must also unset FUNCD_DEVSHELL_KEY.
if [ "${FUNCD_DEVSHELL_KEY:-}" != "$key" ]; then
  if [ ! -s "$env_file" ]; then
    mkdir -p "$root/.cache"
    (cd "$root" && nix print-dev-env >"$env_file.tmp") && mv "$env_file.tmp" "$env_file"
  fi
  # The environment script needs bash 4 (`;&`): an older bash stops sourcing it silently there (#857), so run d under
  # the dev shell's bash, which the part an old bash does source puts on PATH.
  if [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
    dev_bash=$(set +eu; source "$env_file" >/dev/null 2>&1; command -v bash) || true
    if [ -n "$dev_bash" ] && "$dev_bash" -c '((BASH_VERSINFO[0] >= 4))' 2>/dev/null; then
      exec "$dev_bash" "$0" "$@"
    fi
    echo "d: the dev-shell environment needs bash 4 or later, not $BASH_VERSION" >&2
    exit 1
  fi
  orig_path=$PATH
  tmp_base=${TMPDIR:-/tmp}
  saved_tmp=$(declare -p NIX_BUILD_TOP TMPDIR TMP TEMP TEMPDIR 2>/dev/null) || true
  unset NIX_BUILD_TOP
  set +eu # the generated environment script is not written for errexit/nounset
  # shellcheck disable=SC1090
  source "$env_file" >/dev/null 2>&1
  # The script points TMPDIR and its aliases at a new nix-shell.XXXXXX directory that only an interactive shell removes
  # on exit; d execs, so it removes that directory while still empty and restores the caller's values (#856).
  case $NIX_BUILD_TOP in "${tmp_base%/}"/nix-shell.*) rmdir "$NIX_BUILD_TOP" 2>/dev/null ;; esac
  unset NIX_BUILD_TOP TMPDIR TMP TEMP TEMPDIR
  eval "$saved_tmp"
  export PATH="$PATH:$orig_path"
  export FUNCD_DEVSHELL_KEY=$key
fi
# golangci-lint caches each package's issues with their absolute paths, so a cache shared by every worktree replays
# the issues of a removed worktree without its //nolint lines and path rules: each checkout gets its own cache.
export GOLANGCI_LINT_CACHE="${GOLANGCI_LINT_CACHE:-$root/.cache/golangci-lint}"
exec "$@"
